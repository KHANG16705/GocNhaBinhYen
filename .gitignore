# Asset meta data should NEVER be ignored, except for ignored folders above
UnityProject/Assets/AssetStoreTools*
UnityProject/Assets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code / IDE caches
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity build outputs & crash logs
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Local tools / Node / Python scratch
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Office temp lock files
~$*.docx
~$*.xlsx
~$*.pptx
